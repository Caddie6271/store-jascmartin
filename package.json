{
  "name": "store-jascmartin",
  "version": "1.0.0",
  "private": true,
  "description": "Jason Martin Consulting store on Cloudflare Workers",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 execute store-db --local --file=migrations/0001_init.sql",
    "db:remote": "wrangler d1 execute store-db --remote --file=migrations/0001_init.sql"
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
